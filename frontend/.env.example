# API base URL (must include /api). Set in Vercel Environment Variables for production builds.
# Example production: https://your-service.onrender.com/api
NEXT_PUBLIC_API_URL=http://127.0.0.1:8001/api

# Sentry error tracking (frontend) — free 5k events/month.
# Create a project at https://sentry.io → New Project → Next.js
# Copy the DSN from Project Settings → Client Keys. Leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=

# Sentry source-map upload (only needed during CI/CD builds, not at runtime).
# Generate at https://sentry.io → Settings → Auth Tokens
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
