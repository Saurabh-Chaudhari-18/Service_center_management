# Backend .env for production (EC2)
# Copy to Backend/.env and fill in values.
# Do NOT commit .env to git.

DEBUG=False
SECRET_KEY=CHANGE_ME_generate_strong_random_key

# Database - use RDS or local PostgreSQL
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/service_center_db

# Allowed hosts: EC2 public IP or domain
ALLOWED_HOSTS=localhost,127.0.0.1,YOUR_EC2_PUBLIC_IP,yourdomain.com

# CORS - same-origin if frontend served by same Nginx; or add your frontend URL
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://YOUR_EC2_PUBLIC_IP
JWT_COOKIE_SAMESITE=None

# Encryption key for device passwords (required)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional: SMS / WhatsApp
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=SRVCTR
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=

# Set only after successfully restoring a backup into an isolated database.
BACKUP_VERIFICATION_TOKEN=

LOW_STOCK_THRESHOLD=5
