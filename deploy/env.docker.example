# Backend env for Docker Compose (local or EC2)
# Copy to .env in project root. docker-compose reads it.

# Django
DEBUG=False
SECRET_KEY=dev-secret-key-change-in-production

# Database - postgres service in docker-compose
DATABASE_URL=postgres://scm:scm@postgres:5432/scm

# Hosts (use * or localhost,127.0.0.1 for local testing)
ALLOWED_HOSTS=localhost,127.0.0.1,backend,0.0.0.0

# CORS - frontend reached via Nginx at localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Encryption (required)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Optional
LOW_STOCK_THRESHOLD=5
