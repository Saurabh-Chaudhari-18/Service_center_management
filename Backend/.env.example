# ── Django Core ──────────────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
# Generate: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/service_center_db

# ── Allowed Hosts / CORS ─────────────────────────────────────────────────────
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Use None when frontend and backend are on different production domains.
JWT_COOKIE_SAMESITE=Lax
# Set True on Render when using Vercel preview URLs
# CORS_ALLOW_VERCEL=True

# ── Encryption ────────────────────────────────────────────────────────────────
# Required in production — encrypts customer device passwords at rest.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ── Redis (cache + Celery broker) ─────────────────────────────────────────────
# Docker Compose sets this automatically. For EC2 / Render, point to your Redis instance.
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Browser traffic must use a same-origin /api gateway so the signed HTTP-only
# access and refresh cookies are never exposed to JavaScript.

# ── SMS — TextBee (free, Android-as-gateway) ─────────────────────────────────
# Register at https://textbee.dev, install app on an Android phone.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=

# ── WhatsApp ──────────────────────────────────────────────────────────────────
# WHATSAPP_PROVIDER=cloud   → Meta WhatsApp Cloud API (free 1k conv/month) [default]
# WHATSAPP_PROVIDER=twilio  → Twilio (paid)
WHATSAPP_PROVIDER=cloud

# Meta WhatsApp Cloud API (recommended — free)
# Steps: https://developers.facebook.com/docs/whatsapp/cloud-api/get-started
# 1. Create a Meta Business account and add a WhatsApp product.
# 2. Copy the Permanent Access Token and Phone Number ID from the dashboard.
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Twilio (paid — only needed when WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# ── Email / SMTP ──────────────────────────────────────────────────────────────
# For dev/low-volume: Gmail SMTP works out of the box.
# For > 300/day free: switch to Brevo (https://brevo.com) or Resend (https://resend.com).
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# ── Error Tracking — Sentry (free 5k events/month) ───────────────────────────
# Create a free account at https://sentry.io → New Project → Django.
# Copy the DSN and paste it here. Leave blank to disable.
SENTRY_DSN=

# Set to the date/identifier of the latest successful backup restore drill.
# Readiness remains not-ready in production until recovery has been proven.
BACKUP_VERIFICATION_TOKEN=

# ── Misc ──────────────────────────────────────────────────────────────────────
LOW_STOCK_THRESHOLD=5
CONN_MAX_AGE=60
